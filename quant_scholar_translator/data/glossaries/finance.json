  {"source":"venture capital","target":"风险投资","note":"投资高成长早期企业的私募股权策略","aliases":["VC"]},
  {"source":"buyout","target":"并购型投资","note":"取得成熟企业控制权并通过运营、资本结构或战略改进创造价值","requiresContext":true},
