  {"source":"identification strategy","target":"识别策略","note":"causal inference"},
  {"source":"endogeneity","target":"内生性","note":"empirical research"},
  {"source":"instrumental variable","target":"工具变量","note":"causal inference"},
  {"source":"robustness check","target":"稳健性检验","note":"empirical research"},
  {"source":"sensitivity analysis","target":"敏感性分析","note":"research validation"},
  {"source":"replication","target":"复现","note":"research reproducibility"},
  {"source":"peer review","target":"同行评审","note":"publishing"},
  {"source":"appendix","target":"附录","note":"paper section"},
  {"source":"supplementary materials","target":"补充材料","note":"paper assets"},
  {"source":"assumption","target":"假设条件","note":"推导或建模的前提，不应误写成已证明的结论"},
  {"source":"proposition","target":"命题","note":"数学论文的正式陈述，不是商业提案"},
  {"source":"corollary","target":"推论","note":"从已有定理导出的结论"},
  {"source":"proof sketch","target":"证明概要","note":"不应扩写为完整证明"},
  {"source":"counterexample","target":"反例","note":"用于否定一般性陈述"},
  {"source":"ablation study","target":"消融实验","note":"通过移除组件考察贡献，常见于机器学习论文"},
  {"source":"benchmark","target":"基准","note":"按语境译基准模型、基准数据集或性能基准；金融中也可为业绩基准"},
  {"source":"empirical evidence","target":"实证证据","note":"不是数学证明，保留证据强弱措辞"},
  {"source":"external validity","target":"外部效度","note":"结论推广到其他对象或情境的适用性"},
  {"source":"internal validity","target":"内部效度","note":"研究内部因果解释的可靠程度"},
  {"source":"reproducibility","target":"可复现性","note":"不同学科可能区分 reproducibility 与 replicability，遵循文中定义"},
  {"source":"limitations","target":"研究局限","note":"不可省略适用范围和限制条件"},
  {"source":"causal inference","target":"因果推断","note":"研究干预或暴露对结果的因果效应，不等同于相关性"},
  {"source":"confounder","target":"混杂因素","note":"同时影响处理与结果、可能造成虚假关联的变量","aliases":["confounding variable"]},
  {"source":"selection bias","target":"选择偏差","note":"样本进入研究或分析的机制引起的系统性偏差"},
  {"source":"measurement error","target":"测量误差","note":"观测量与目标真值之间的误差；保留经典或非经典误差设定"},
  {"source":"systematic review","target":"系统综述","note":"按预定方案系统检索、筛选和综合证据"},
  {"source":"meta-analysis","target":"荟萃分析","note":"对多个研究的效应量进行统计合并；亦译元分析","aliases":["meta analysis"]},
  {"source":"pre-registration","target":"预注册","note":"研究实施或分析前登记方案，以区分验证性与探索性分析","aliases":["preregistration","pre-registration"]},
  {"source":"data-generating process","target":"数据生成过程","note":"产生观测数据的概率机制，常缩写为 DGP","aliases":["data generating process","DGP"]},
  {"source":"baseline specification","target":"基准设定","note":"实证分析的主要模型设定，不等于业绩比较基准"},
  {"source":"specification test","target":"设定检验","note":"检验模型设定或函数形式，不等同于一般显著性检验"},
  {"source":"sample selection","target":"样本选择","note":"说明样本纳入、排除及其潜在偏差"},
  {"source":"control group","target":"对照组","note":"用于估计反事实结果的比较组"},
  {"source":"treatment group","target":"处理组","note":"接受干预或暴露于处理的研究组"},
  {"source":"randomized controlled trial","target":"随机对照试验","note":"通过随机分配处理降低混杂；缩写 RCT 保留","aliases":["randomised controlled trial","RCT"]},
  {"source":"statistically significant","target":"具有统计显著性","note":"不可据此直接推断效应重要、因果成立或结果可复现"},
  {"source":"research design","target":"研究设计","note":"研究问题、样本、测量、识别与分析方案的总体安排"},
  {"source":"conceptual framework","target":"概念框架","note":"组织核心概念及其关系的分析框架；区别于具体估计模型"},
  {"source":"theoretical framework","target":"理论框架","note":"研究所依据的理论体系及推导关系"},
  {"source":"estimand","target":"目标估计量","note":"研究希望识别的总体量；区别于 estimator 和 estimate"},
  {"source":"treatment effect heterogeneity","target":"处理效应异质性","note":"处理效应随个体、群体或条件变化","aliases":["heterogeneous treatment effects","HTE"]},
  {"source":"mediator variable","target":"中介变量","note":"描述处理影响结果的作用路径；中介分析需额外识别假设","aliases":["mediator"]},
  {"source":"moderator variable","target":"调节变量","note":"改变关系方向或强度的变量；区别于中介变量","aliases":["moderator"]},
  {"source":"construct validity","target":"构念效度","note":"测量或操作化是否真正对应理论构念"},
  {"source":"ecological validity","target":"生态效度","note":"研究结果在真实情境中的适用程度"},
  {"source":"publication bias","target":"发表偏倚","note":"显著或正向结果更易发表造成的证据偏差"},
  {"source":"reporting bias","target":"报告偏倚","note":"结果或分析被选择性报告造成的偏差"},
  {"source":"p-hacking","target":"P 值操纵","note":"通过多次尝试分析方案追求显著结果；保留其不当研究实践含义"},
  {"source":"data dredging","target":"数据捞取","note":"缺乏预先假设而反复搜寻显著模式，可能放大假阳性","aliases":["data fishing"]},
  {"source":"registered report","target":"注册报告","note":"研究实施前评审问题与方法，结果通常不决定最终接收"},
  {"source":"open science","target":"开放科学","note":"提高研究材料、数据、代码和流程透明度的实践"},
  {"source":"data availability statement","target":"数据可用性声明","note":"说明研究数据能否以及如何获取","aliases":["DAS"]},
  {"source":"conflict of interest","target":"利益冲突","note":"可能影响研究判断的财务或非财务关系","aliases":["competing interests","COI"]},
  {"source":"corresponding author","target":"通讯作者","note":"负责稿件通信的作者，不必然等于第一作者"},
  {"source":"preprint","target":"预印本","note":"尚未完成正式同行评议的公开稿件"},
  {"source":"systematic error","target":"系统误差","note":"以稳定方向影响测量或估计的误差；区别于随机误差"},
  {"source":"random error","target":"随机误差","note":"由随机波动产生、方向不固定的误差"}
]
