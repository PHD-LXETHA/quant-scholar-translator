[
  {"source":"abstract","target":"摘要","note":"paper section"},
  {"source":"methodology","target":"研究方法","note":"academic research"},
  {"source":"research question","target":"研究问题","note":"academic research"},
  {"source":"literature review","target":"文献综述","note":"paper section"},
  {"source":"hypothesis","target":"研究假设","note":"empirical paper"},
  {"source":"identification strategy","target":"识别策略","note":"causal inference"},
  {"source":"endogeneity","target":"内生性","note":"empirical research"},
  {"source":"instrumental variable","target":"工具变量","note":"causal inference"},
  {"source":"robustness check","target":"稳健性检验","note":"empirical research"},
  {"source":"sensitivity analysis","target":"敏感性分析","note":"research validation"},
  {"source":"replication","target":"复现","note":"research reproducibility"},
  {"source":"peer review","target":"同行评审","note":"publishing"},
  {"source":"appendix","target":"附录","note":"paper section"},
  {"source":"supplementary materials","target":"补充材料","note":"paper assets"},
  {"source":"assumption","target":"假设条件","note":"推导或建模的前提，不应误写成已证明的结论"},
  {"source":"proposition","target":"命题","note":"数学论文的正式陈述，不是商业提案"},
  {"source":"corollary","target":"推论","note":"从已有定理导出的结论"},
  {"source":"proof sketch","target":"证明概要","note":"不应扩写为完整证明"},
  {"source":"counterexample","target":"反例","note":"用于否定一般性陈述"},
  {"source":"ablation study","target":"消融实验","note":"通过移除组件考察贡献，常见于机器学习论文"},
  {"source":"benchmark","target":"基准","note":"按语境译基准模型、基准数据集或性能基准；金融中也可为业绩基准"},
  {"source":"empirical evidence","target":"实证证据","note":"不是数学证明，保留证据强弱措辞"},
  {"source":"external validity","target":"外部效度","note":"结论推广到其他对象或情境的适用性"},
  {"source":"internal validity","target":"内部效度","note":"研究内部因果解释的可靠程度"},
  {"source":"reproducibility","target":"可复现性","note":"不同学科可能区分 reproducibility 与 replicability，遵循文中定义"},
  {"source":"limitations","target":"研究局限","note":"不可省略适用范围和限制条件"},
  {"source":"causal inference","target":"因果推断","note":"研究干预或暴露对结果的因果效应，不等同于相关性"},
  {"source":"confounder","target":"混杂因素","note":"同时影响处理与结果、可能造成虚假关联的变量","aliases":["confounding variable"]},
  {"source":"selection bias","target":"选择偏差","note":"样本进入研究或分析的机制引起的系统性偏差"},
  {"source":"measurement error","target":"测量误差","note":"观测量与目标真值之间的误差；保留经典或非经典误差设定"},
  {"source":"systematic review","target":"系统综述","note":"按预定方案系统检索、筛选和综合证据"},
  {"source":"meta-analysis","target":"荟萃分析","note":"对多个研究的效应量进行统计合并；亦译元分析","aliases":["meta analysis"]},
  {"source":"pre-registration","target":"预注册","note":"研究实施或分析前登记方案，以区分验证性与探索性分析","aliases":["preregistration","pre-registration"]},
  {"source":"data-generating process","target":"数据生成过程","note":"产生观测数据的概率机制，常缩写为 DGP","aliases":["data generating process","DGP"]},
  {"source":"baseline specification","target":"基准设定","note":"实证分析的主要模型设定，不等于业绩比较基准"},
  {"source":"specification test","target":"设定检验","note":"检验模型设定或函数形式，不等同于一般显著性检验"},
  {"source":"sample selection","target":"样本选择","note":"说明样本纳入、排除及其潜在偏差"},
  {"source":"control group","target":"对照组","note":"用于估计反事实结果的比较组"},
  {"source":"treatment group","target":"处理组","note":"接受干预或暴露于处理的研究组"},
  {"source":"randomized controlled trial","target":"随机对照试验","note":"通过随机分配处理降低混杂；缩写 RCT 保留","aliases":["randomised controlled trial","RCT"]},
  {"source":"statistically significant","target":"具有统计显著性","note":"不可据此直接推断效应重要、因果成立或结果可复现"},
  {"source":"research design","target":"研究设计","note":"研究问题、样本、测量、识别与分析方案的总体安排"},
  {"source":"conceptual framework","target":"概念框架","note":"组织核心概念及其关系的分析框架；区别于具体估计模型"},
  {"source":"theoretical framework","target":"理论框架","note":"研究所依据的理论体系及推导关系"},
  {"source":"estimand","target":"目标估计量","note":"研究希望识别的总体量；区别于 estimator 和 estimate","strict":true},
  {"source":"treatment effect heterogeneity","target":"处理效应异质性","note":"处理效应随个体、群体或条件变化","aliases":["heterogeneous treatment effects","HTE"]},
  {"source":"mediator variable","target":"中介变量","note":"描述处理影响结果的作用路径；中介分析需额外识别假设","aliases":["mediator"]},
  {"source":"moderator variable","target":"调节变量","note":"改变关系方向或强度的变量；区别于中介变量","aliases":["moderator"]},
  {"source":"construct validity","target":"构念效度","note":"测量或操作化是否真正对应理论构念"},
  {"source":"ecological validity","target":"生态效度","note":"研究结果在真实情境中的适用程度"},
  {"source":"publication bias","target":"发表偏倚","note":"显著或正向结果更易发表造成的证据偏差"},
  {"source":"reporting bias","target":"报告偏倚","note":"结果或分析被选择性报告造成的偏差"},
  {"source":"p-hacking","target":"P 值操纵","note":"通过多次尝试分析方案追求显著结果；保留其不当研究实践含义"},
  {"source":"data dredging","target":"数据捞取","note":"缺乏预先假设而反复搜寻显著模式，可能放大假阳性","aliases":["data fishing"]},
  {"source":"registered report","target":"注册报告","note":"研究实施前评审问题与方法，结果通常不决定最终接收"},
  {"source":"open science","target":"开放科学","note":"提高研究材料、数据、代码和流程透明度的实践"},
  {"source":"data availability statement","target":"数据可用性声明","note":"说明研究数据能否以及如何获取","aliases":["DAS"]},
  {"source":"conflict of interest","target":"利益冲突","note":"可能影响研究判断的财务或非财务关系","aliases":["competing interests","COI"]},
  {"source":"corresponding author","target":"通讯作者","note":"负责稿件通信的作者，不必然等于第一作者"},
  {"source":"preprint","target":"预印本","note":"尚未完成正式同行评议的公开稿件"},
  {"source":"systematic error","target":"系统误差","note":"以稳定方向影响测量或估计的误差；区别于随机误差"},
  {"source":"random error","target":"随机误差","note":"由随机波动产生、方向不固定的误差"},
  {"source":"research protocol","target":"研究方案","note":"研究实施前规定目标、设计、样本和分析方法的正式文件"},
  {"source":"protocol deviation","target":"方案偏离","note":"实际研究实施与预定研究方案不一致的情形"},
  {"source":"attrition bias","target":"失访偏倚","note":"退出或缺失与处理或结果相关造成的系统偏差"},
  {"source":"loss to follow-up","target":"失访","note":"受试者在随访期间无法继续观察；需报告数量与原因","aliases":["lost to follow-up"]},
  {"source":"blinding","target":"盲法","note":"使参与者、研究人员或评估者不知道分组以减少偏倚","aliases":["masking"]},
  {"source":"allocation concealment","target":"分配隐藏","note":"在分配前防止研究人员预知下一组别；区别于分配后的盲法"},
  {"source":"intention-to-treat analysis","target":"意向性治疗分析","note":"按最初随机分组分析所有参与者，不因依从性改变分组","aliases":["ITT analysis"]},
  {"source":"per-protocol analysis","target":"符合方案分析","note":"只分析充分遵循研究方案的参与者；可能引入选择偏倚","aliases":["PP analysis"]},
  {"source":"null result","target":"零结果","note":"未发现预设效应或统计证据的结果；不等于证明完全无效应"},
  {"source":"data provenance","target":"数据溯源","note":"记录数据来源、处理步骤和派生关系"},
  {"source":"code availability statement","target":"代码可用性声明","note":"说明分析代码能否以及如何获取"},
  {"source":"plagiarism","target":"抄袭","note":"未适当注明来源而使用他人的文字、思想或成果"},
  {"source":"paraphrase","target":"转述","note":"用不同措辞表达原意，仍需在适当情况下标注来源"},
  {"source":"citation context","target":"引文语境","note":"引用在正文中承担的支持、对比、方法或背景作用"},
  {"source":"fiduciary duty","target":"受托责任","note":"受托人应以客户或受益人利益为先并履行忠诚、审慎和注意义务","aliases":["fiduciary duties"]},
  {"source":"material nonpublic information","target":"重大非公开信息","note":"尚未公开且理性投资者可能认为会影响投资决定或证券价格的信息","aliases":["MNPI"]},
  {"source":"fair dealing","target":"公平对待","note":"向客户提供投资分析、建议或交易机会时公平、客观地处理，不要求结果完全相同"},
  {"source":"suitability","target":"适当性","note":"投资建议或操作应符合客户目标、约束、风险承受能力及整体投资组合"},
  {"source":"diligence and reasonable basis","target":"勤勉与合理依据","note":"分析、建议和行动应经过充分调查并具有合理、适当的依据"},
  {"source":"priority of transactions","target":"交易优先顺序","note":"客户和雇主交易应优先于从业人员可获个人利益的交易"},
  {"source":"referral fee","target":"推荐费","note":"因推荐客户或业务而收取或支付的报酬；应按适用规则充分披露","aliases":["referral fees"]},
  {"source":"soft dollar arrangement","target":"软美元安排","note":"用客户佣金换取研究或经纪服务的安排；需评估服务是否有利于客户","aliases":["soft commission arrangement","soft dollars"]},
  {"source":"mosaic theory","target":"马赛克理论","note":"将公开信息与非重大非公开信息组合形成投资结论，不包含重大非公开信息"},
  {"source":"professional misconduct","target":"专业失当行为","note":"损害诚信、声誉或专业胜任能力的职业相关行为"},
  {"source":"market manipulation","target":"市场操纵","note":"通过虚假信息、扭曲价格或人为交易活动误导市场参与者"},
  {"source":"performance presentation","target":"业绩展示","note":"向客户或潜在客户呈现投资业绩时应公平、准确、完整且不具误导性"},
  {"source":"record retention","target":"记录保存","note":"保留支持投资分析、建议、行动与客户沟通的适当记录"},
  {"source":"whistleblowing","target":"举报不当行为","note":"向有权处理的内部或外部渠道报告违法、违规或严重不当行为"},
  {"source":"Global Investment Performance Standards","target":"全球投资业绩标准","note":"CFA Institute 发布的投资业绩展示道德标准，通常保留 GIPS 缩写","aliases":["GIPS"]},
  {"source":"composite","target":"组合群","note":"GIPS 语境中按相似投资授权、目标或策略归集的一个或多个投资组合","requiresContext":true},
  {"source":"GIPS verification","target":"GIPS 验证","note":"由独立第三方对公司层面组合群构建及政策程序是否符合 GIPS 要求进行检验","aliases":["verification"]},
  {"source":"discretionary portfolio","target":"全权委托投资组合","note":"投资管理人对投资决策拥有实际自主权、可按既定策略管理的组合"},
  {"source":"total firm assets","target":"公司管理资产总额","note":"GIPS 报告口径下公司所管理资产的汇总值，需遵循公司定义和适用规则"},
  {"source":"independence and objectivity","target":"独立性与客观性","note":"专业判断不受礼品、利益冲突、压力或其他外部影响的不当干扰"},
  {"source":"replication package","target":"复现资料包","note":"用于复核研究结果的代码、数据或获取说明、运行环境和执行步骤集合。","aliases":["replication packages"]},
  {"source":"negative control","target":"阴性对照","note":"预期不受研究机制影响的暴露或结果，用于探查残余混杂或其他偏倚；不能单独证明无偏。","aliases":["negative controls"]},
  {"source":"replicability","target":"可重复验证性","note":"此处按 NASEM 口径指独立研究使用新数据对同一问题获得一致结论；不同学科可能反用此词与 reproducibility，须遵从论文定义。","aliases":["replicable results"]},
  {"source":"computational reproducibility","target":"计算可复现性","note":"按相同输入数据、计算步骤、代码及分析条件重现一致结果；不等于用新数据重复验证。","aliases":["computationally reproducible"]},
  {"source":"equivalence test","target":"等效性检验","note":"检验效应差异是否落在预先指定的等效界值内；常规差异检验不显著并不能证明等效。","aliases":["equivalence testing","equivalence tests"]},
  {"source":"non-inferiority test","target":"非劣效性检验","note":"依据预先设定的界值检验某方案是否没有差到不可接受的程度；不等于证明完全相同或优于对照。","aliases":["noninferiority test","non-inferiority testing","noninferiority tests","non-inferiority tests"]},
  {"source":"researcher degrees of freedom","target":"研究者自由度","note":"数据筛选、变量定义和分析路径中的可选择空间；未透明披露时可能增加选择性报告和假阳性风险。","aliases":["researchers' degrees of freedom","analytic flexibility"]},
  {"source":"multiverse analysis","target":"多宇宙分析","note":"系统执行一组合理分析选择以检验结论对分析路径的敏感性；并非任意枚举不合理模型。","aliases":["multiverse analyses"]},
  {"source":"specification curve analysis","target":"设定曲线分析","note":"展示并汇总一组理论合理、统计有效且非冗余模型设定的结果，用于评估结论稳健性。","aliases":["specification curve","specification-curve analysis"]},
  {"source":"reporting guideline","target":"报告规范","note":"针对研究类型规定应报告信息的清单或框架；遵循规范不等于研究设计本身无偏。","aliases":["reporting guidelines"]},
  {"source":"reproducible workflow","target":"可复现工作流","note":"使数据、代码、环境与分析步骤可追踪并可重复运行的研究流程；不等同于独立新数据的重复验证。","aliases":["reproducible research workflow"]},
  {"source":"operationalization","target":"操作化","note":"把理论构念转化为可观察、可测量变量或程序的过程；操作指标不一定完整代表构念。","aliases":["operationalisation"]},
  {"source":"prespecification","target":"预先设定","note":"在观察分析结果之前明确结局、模型与决策规则；不能自动消除所有研究者自由度。","aliases":["pre-specification","prespecified"]},
  {"source":"primary outcome","target":"主要结局","note":"研究方案预先指定、用于回答主要问题的核心结局指标；应与探索性结局区分。","aliases":["primary endpoint"]},
  {"source":"post hoc analysis","target":"事后分析","note":"观察数据或主要结果后提出或调整的分析；应明确标注探索性，避免当作预设验证性证据。","aliases":["post-hoc analysis"]},
  {"source":"risk of bias","target":"偏倚风险","note":"研究设计、实施、分析或报告导致系统性偏离真实效应的可能性；不同于结果的随机不精确性。","aliases":["bias risk"]},
  {"source":"operational measure","target":"操作性测量","note":"为理论构念指定的可观察测量指标；属于操作化结果之一，但不等同于操作化过程。","aliases":["operational measurement"],"targetVariants":["操作化测量"]},
  {"source":"post hoc outcome","target":"事后结局","note":"查看数据或主要结果后才选择或定义的结局；须标注探索性，不能冒充预设主要结局。","aliases":["post-hoc outcome"]}
]
